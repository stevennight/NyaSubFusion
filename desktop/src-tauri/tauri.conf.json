{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyaSubFusion",
  "version": "0.1.0",
  "identifier": "app.nyasubfusion.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NyaSubFusion",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "core/": "core/"
    },
    "publisher": "NyaSubFusion",
    "shortDescription": "多源字幕生成与翻译",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
